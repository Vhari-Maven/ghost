# secrets.list — which encrypted keys to decrypt into podman secrets for this project.
# Format: <podman-secret-name>:<source-stem>   (decrypted from ~/.secrets-enc/<stem>.gpg)
# Blank lines and # comments are ignored.
#
# Each entry here also needs a matching --secret=... line in devcontainer.json runArgs.

github_token:github-token
# openrouter_key:openrouter-api-key
# anthropic_key:anthropic-api-key
fly_token:fly-api-token
